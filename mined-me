          breatheInterval = setInterval(() => {
            exhaleTime--;
            if (exhaleTime > 0) {
              timerText.innerText = exhaleTime;
            } else {
              clearInterval(breatheInterval);
              if (isBreathing) {
                breatheCycle++;
                executeSingleCycle();
              }
            }
          }, 1000);
        }
      }, 1000);
    }

