<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>마음 숲 정원</title>
  <!-- 구글 폰트 로드 실패 시에도 형태를 유지하도록 웹 안전 손글씨 폴백 지정 -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Gaegu:wght@400;700&family=Noto+Sans+KR:wght@300;400;500;700&display=swap" rel="stylesheet">
  
  <style>
    /* 1. 노션 iframe 완벽 호환 CSS 리셋 */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-tap-highlight-color: transparent;
    }

    html, body {
      width: 100%;
      height: auto;
      min-height: 100%;
      background-color: #0c1520;
      color: #e8f1ec;
      font-family: 'Gaegu', -apple-system, BlinkMacSystemFont, "Apple SD Gothic Neo", "Malgun Gothic", sans-serif;
      overflow-x: hidden;
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
    }

    .font-sans-kr {
      font-family: 'Noto Sans KR', -apple-system, BlinkMacSystemFont, sans-serif;
    }

    /* 반응형 레이아웃 래퍼 (노션 가로폭에 따라 100% 유동 조절) */
    .app-container {
      width: 100%;
      max-width: 680px;
      margin: 0 auto;
      padding: 16px 14px 40px 14px;
      display: flex;
      flex-direction: column;
      position: relative;
    }

    /* 카드 베이스 */
    .card {
      background: rgba(18, 34, 46, 0.95);
      border: 1px solid rgba(16, 185, 129, 0.25);
      border-radius: 20px;
      padding: 20px 16px;
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5);
      margin-bottom: 16px;
      position: relative;
    }

    /* 버튼 스타일 */
    .btn-menu {
      width: 100%;
      background: linear-gradient(135deg, #142938 0%, #123126 100%);
      border: 1px solid rgba(16, 185, 129, 0.3);
      border-radius: 16px;
      padding: 16px 14px;
      margin-bottom: 12px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      color: #fff;
      cursor: pointer;
      text-align: left;
      transition: all 0.2s ease;
      touch-action: manipulation;
    }
    .btn-menu:active {
      transform: scale(0.98);
      background: #174031;
    }

    .btn-primary {
      width: 100%;
      background-color: #2d6144;
      color: #ffffff;
      border: none;
      border-radius: 14px;
      padding: 14px 18px;
      font-size: 1.15rem;
      font-weight: 700;
      cursor: pointer;
      margin-top: 12px;
      touch-action: manipulation;
      transition: background 0.2s ease;
    }
    .btn-primary:active {
      background-color: #3b7a57;
      transform: scale(0.98);
    }

    .btn-sub {
      background-color: #173024;
      border: 1px solid rgba(16, 185, 129, 0.3);
      border-radius: 12px;
      padding: 12px 14px;
      width: 100%;
      color: #e2f7ea;
      cursor: pointer;
      text-align: left;
      margin-bottom: 10px;
      font-size: 0.95rem;
      touch-action: manipulation;
    }
    .btn-sub:active {
      background-color: #1f4232;
    }

    /* 헤더 스타일 */
    .header-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-bottom: 14px;
      margin-bottom: 16px;
      border-bottom: 1px solid rgba(16, 185, 129, 0.2);
    }

    /* 반짝이는 별 효과 (가벼운 CSS) */
    .star-badge {
      display: inline-block;
      animation: pulseStar 2.5s infinite ease-in-out;
    }
    @keyframes pulseStar {
      0%, 100% { opacity: 0.5; transform: scale(0.95); }
      50% { opacity: 1; transform: scale(1.1); }
    }

    /* 호흡 원 애니메이션 */
    .breathe-circle {
      width: 130px;
      height: 130px;
      border-radius: 50%;
      border: 4px solid #fde047;
      background: rgba(16, 185, 129, 0.2);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      margin: 0 auto;
      transition: transform 4s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .breathe-expand {
      transform: scale(1.3);
      transition: transform 4s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .breathe-contract {
      transform: scale(0.85);
      transition: transform 6s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* 호흡 뷰어 박스 */
    .breathe-box {
      width: 100%;
      height: 220px;
      position: relative;
      border-radius: 16px;
      overflow: hidden;
      margin-bottom: 16px;
      border: 1px solid rgba(16, 185, 129, 0.3);
    }
    .breathe-box img {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: opacity 1s ease-in-out;
    }

    /* 텍스트에어리어 */
    textarea {
      width: 100%;
      background: #0c1520;
      border: 1px solid rgba(16, 185, 129, 0.4);
      border-radius: 12px;
      padding: 12px;
      color: #fff;
      font-size: 0.95rem;
      outline: none;
      resize: vertical;
    }
    textarea:focus {
      border-color: #34d399;
    }

    /* 슬라이더 */
    input[type=range] {
      width: 100%;
      accent-color: #10b981;
      height: 6px;
      border-radius: 4px;
      background: #0c1520;
      cursor: pointer;
    }

    .hidden {
      display: none !important;
    }
  </style>
</head>
<body>

  <div class="app-container">
    <!-- 헤더 -->
    <header class="header-bar">
      <div onclick="goToHome()" style="cursor: pointer; display: flex; align-items: center; gap: 8px;">
        <span style="font-size: 1.8rem;">🌲</span>
        <div>
          <h1 style="font-size: 1.6rem; color: #a7f3d0; line-height: 1.1;">
            마음 숲 정원 <span class="star-badge" style="color: #fde047;">⭐</span>
          </h1>
          <p class="font-sans-kr" style="font-size: 0.75rem; color: #6ee7b7; font-weight: 300;">나를 편안히 안아주는 쉼터</p>
        </div>
      </div>
      <div style="font-size: 1.2rem;">🍀</div>
    </header>

    <!-- [1] 홈 화면 -->
    <section id="screen-home">
      <div class="card" style="text-align: center;">
        <span style="display: inline-block; background: rgba(26, 56, 43, 0.8); border: 1px solid rgba(16, 185, 129, 0.4); padding: 4px 12px; border-radius: 20px; font-size: 0.85rem; color: #a7f3d0; margin-bottom: 12px;">
          ☘️ 조용한 숲속에서 쉬어가기
        </span>
        <h2 style="font-size: 1.8rem; margin-bottom: 8px;">지금 마음에 필요한 것은?</h2>
        <p class="font-sans-kr" style="font-size: 0.9rem; color: #a7f3d0; line-height: 1.5; font-weight: 300;">
          거센 파도가 일 때도 숲은 자리를 지킵니다.<br>
          당신의 속도에 맞춰 한 걸음씩 가볍게 머물러보세요.
        </p>

        <!-- 핵심 문구 -->
        <div style="margin-top: 14px; background: rgba(15, 42, 32, 0.9); border: 1px solid rgba(52, 211, 153, 0.4); border-radius: 12px; padding: 12px 10px; color: #ecfdf5; font-size: 1.05rem; font-weight: bold; line-height: 1.4;">
          <span style="color: #fde047;">⭐</span>
          "'왜' 보다는 '어떻게'를 생각하기. 나는 끔찍이보다 부지런하다!"
          <span style="color: #fde047;">⭐</span>
        </div>
      </div>

      <!-- 3가지 선택 메뉴 -->
      <div class="font-sans-kr">
        <div class="btn-menu" onclick="startBreathing()">
          <div style="display: flex; align-items: center; gap: 12px;">
            <span style="font-size: 1.8rem;">🌙</span>
            <div>
              <div style="font-family: 'Gaegu'; font-size: 1.4rem; font-weight: bold; color: #e2f7ea;">1. 호흡하기</div>
              <div style="font-size: 0.8rem; color: #6ee7b7;">밤하늘과 호수 풍경 속 4·6 호흡</div>
            </div>
          </div>
          <span style="color: #34d399; font-size: 1.2rem;">➔</span>
        </div>

        <div class="btn-menu" onclick="startGrounding()">
          <div style="display: flex; align-items: center; gap: 12px;">
            <span style="font-size: 1.8rem;">🌿</span>
            <div>
              <div style="font-family: 'Gaegu'; font-size: 1.4rem; font-weight: bold; color: #e2f7ea;">2. 그라운딩 (5-4-3-2-1)</div>
              <div style="font-size: 0.8rem; color: #6ee7b7;">오감을 깨워 '지금, 여기'에 닻 내리기</div>
            </div>
          </div>
          <span style="color: #34d399; font-size: 1.2rem;">➔</span>
        </div>

        <div class="btn-menu" onclick="startShadowEscape()">
          <div style="display: flex; align-items: center; gap: 12px;">
            <span style="font-size: 1.8rem;">🧭</span>
            <div>
              <div style="font-family: 'Gaegu'; font-size: 1.4rem; font-weight: bold; color: #e2f7ea;">3. 그림자 탈출 매뉴얼</div>
              <div style="font-size: 0.8rem; color: #6ee7b7;">우울·불안·무기력 원인별 심리 솔루션</div>
            </div>
          </div>
          <span style="color: #34d399; font-size: 1.2rem;">➔</span>
        </div>
      </div>
    </section>

    <!-- [2] 호흡하기 화면 -->
    <section id="screen-breathing" class="hidden">
      <!-- 준비 화면 -->
      <div id="breathe-prep-box" class="card" style="text-align: center;">
        <span style="font-size: 3rem;">🧘‍♀️</span>
        <h2 style="font-size: 1.8rem; margin: 8px 0;">호흡을 위한 준비</h2>
        <div class="font-sans-kr" style="background: #173024; padding: 14px; border-radius: 12px; border: 1px solid rgba(16, 185, 129, 0.3); font-size: 0.95rem; line-height: 1.5; color: #d1fae5; margin: 12px 0;">
          몸을 편안하게 이완하고 눈을 지그시 감습니다.<br>
          어깨와 턱의 힘을 툭 빼주세요.
        </div>
        <p class="font-sans-kr" style="font-size: 0.8rem; color: #6ee7b7; margin-bottom: 12px;">
          4초간 밤하늘 들이쉬기 · 6초간 호수 내쉬기 (총 10회)
        </p>
        <button class="btn-primary" onclick="runBreatheCycle()">호흡 시작하기 🌲</button>
      </div>

      <!-- 호흡 루프 화면 -->
      <div id="breathe-active-box" class="card hidden" style="text-align: center;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
          <span class="font-sans-kr" style="font-size: 0.8rem; background: rgba(6, 78, 59, 0.6); padding: 3px 10px; border-radius: 12px; color: #a7f3d0;">
            반복: <strong id="breathe-cycle-count" style="color: #fff;">1</strong> / 10회
          </span>
          <span class="font-sans-kr" onclick="stopBreathing(); goToHome();" style="font-size: 0.8rem; color: #9ca3af; text-decoration: underline; cursor: pointer;">그만하기</span>
        </div>

        <div class="breathe-box">
          <img id="img-inhale" src="https://images.unsplash.com/photo-1506703719100-a0f3a48c0f86?auto=format&fit=crop&w=800&q=80" style="opacity: 1;" alt="밤하늘">
          <img id="img-exhale" src="https://images.unsplash.com/photo-1448375240586-882707db888b?auto=format&fit=crop&w=800&q=80" style="opacity: 0;" alt="호수숲">
          <div style="position: absolute; inset: 0; background: rgba(0,0,0,0.35);"></div>

          <div style="position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;">
            <div id="breathe-circle" class="breathe-circle">
              <span id="breathe-phase-text" style="font-size: 1.4rem; font-weight: bold; color: #fff;">들이쉬기</span>
              <span id="breathe-timer" style="font-size: 2.2rem; font-weight: bold; color: #fde047;">4</span>
            </div>
          </div>
        </div>

        <p id="breathe-guide-comment" class="font-sans-kr" style="font-size: 0.95rem; color: #a7f3d0;">
          밤하늘의 맑은 별빛 기운을 천천히 들이마십니다.
        </p>
      </div>
    </section>

    <!-- [3] 그라운딩 화면 -->
    <section id="screen-grounding" class="hidden">
      <div class="card font-sans-kr">
        <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(16, 185, 129, 0.2); padding-bottom: 10px; margin-bottom: 14px;">
          <h2 style="font-family: 'Gaegu'; font-size: 1.6rem; color: #fff;">🌿 감각 그라운딩</h2>
          <span id="grounding-step-badge" style="font-size: 0.75rem; background: #064e3b; padding: 2px 8px; border-radius: 10px; color: #6ee7b7;">1단계 / 5단계</span>
        </div>

        <div id="grounding-content-area"></div>

        <div style="display: flex; justify-content: space-between; gap: 8px; margin-top: 16px;">
          <button id="grounding-prev-btn" onclick="prevGroundingStep()" style="background: transparent; border: 1px solid rgba(16, 185, 129, 0.4); color: #6ee7b7; border-radius: 10px; padding: 8px 14px; cursor: pointer;">이전</button>
          <button id="grounding-next-btn" onclick="nextGroundingStep()" style="background: #2d6144; border: none; color: #fff; border-radius: 10px; padding: 10px 18px; font-weight: bold; cursor: pointer;">다음 감각 ➔</button>
        </div>
      </div>
    </section>

    <!-- [4] 그림자 탈출 매뉴얼 화면 -->
    <section id="screen-shadow" class="hidden">
      <div id="shadow-step-1" class="card font-sans-kr">
        <div style="text-align: center; margin-bottom: 16px;">
          <span style="font-size: 2.2rem;">🧭</span>
          <h2 style="font-family: 'Gaegu'; font-size: 1.8rem; margin: 4px 0;">어떤 그림자가 머물고 있나요?</h2>
          <p style="font-size: 0.85rem; color: #6ee7b7;">내면의 신호에 귀를 기울여주세요.</p>
        </div>

        <button class="btn-sub" onclick="selectEmotion('depression')">🌧️ 우울한가요?</button>
        <button class="btn-sub" onclick="selectEmotion('anxiety')">⚡ 불안한가요?</button>
        <button class="btn-sub" onclick="selectEmotion('lethargy')">🥀 우울하고 불안한데 무기력까지?</button>
        <button class="btn-sub" onclick="selectEmotion('denial')">🌫️ 내가 내 감정을 부정하고 있음</button>
      </div>

      <div id="shadow-step-2" class="hidden font-sans-kr">
        <div onclick="backToEmotionSelect()" style="color: #6ee7b7; font-size: 0.85rem; margin-bottom: 10px; cursor: pointer; display: inline-block;">
          ⬅ 감정 다시 선택하기
        </div>
        <div id="shadow-detail-content"></div>
      </div>
    </section>

    <!-- [5] 점수 체크 & 숲의 우체통 -->
    <section id="screen-score" class="hidden">
      <div class="card font-sans-kr" style="text-align: center;">
        <span style="font-size: 2.5rem;">☘️</span>
        <h2 style="font-family: 'Gaegu'; font-size: 1.8rem; margin: 6px 0;">마음 돌봄 세션을 마쳤습니다</h2>
        <p style="font-size: 0.85rem; color: #6ee7b7; margin-bottom: 16px;">지금 불안이나 우울의 정도는 몇 점인가요?</p>

        <!-- 슬라이더 -->
        <div style="background: #14281f; padding: 14px; border-radius: 14px; border: 1px solid rgba(16, 185, 129, 0.3); margin-bottom: 16px;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
            <span style="font-size: 0.75rem; color: #a7f3d0;">편안함 (0점)</span>
            <span id="score-display" style="font-family: 'Gaegu'; font-size: 1.8rem; font-weight: bold; color: #fde047;">5점</span>
            <span style="font-size: 0.75rem; color: #a7f3d0;">버거움 (10점)</span>
          </div>
          <input id="score-slider" type="range" min="0" max="10" value="5" oninput="updateScoreVal(this.value)">
        </div>

        <!-- 숲의 우체통 -->
        <div style="background: linear-gradient(to bottom, #183a2d, #12281e); border: 1px solid rgba(52, 211, 153, 0.4); border-radius: 16px; padding: 16px; text-align: left; margin-bottom: 16px;">
          <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(16, 185, 129, 0.3); padding-bottom: 8px; margin-bottom: 10px;">
            <span style="font-weight: bold; color: #a7f3d0; font-size: 0.95rem;">📬 숲의 우체통에서 온 편지</span>
            <span onclick="drawRandomQuote()" style="font-size: 0.75rem; background: #064e3b; padding: 3px 8px; border-radius: 6px; cursor: pointer; color: #d1fae5;">다른 편지 ↺</span>
          </div>
          <div id="postbox-quote-text" style="font-size: 0.9rem; line-height: 1.6; color: #f0fdf4; margin-bottom: 8px; white-space: pre-line;"></div>
          <div id="postbox-quote-source" style="font-size: 0.75rem; text-align: right; color: #6ee7b7;"></div>
        </div>

        <button class="btn-primary" onclick="goToHome()">정원 입구로 돌아가기 🌲</button>
      </div>
    </section>

  </div>

  <script>
    // 1. 화면 전환 함수
    const screens = ['screen-home', 'screen-breathing', 'screen-grounding', 'screen-shadow', 'screen-score'];
    function switchScreen(targetScreenId) {
      screens.forEach(id => {
        const el = document.getElementById(id);
        if (el) el.classList.add('hidden');
      });
      const target = document.getElementById(targetScreenId);
      if (target) target.classList.remove('hidden');
      window.scrollTo(0, 0);
    }

    function goToHome() {
      stopBreathing();
      switchScreen('screen-home');
    }

    function openScoreCheck() {
      stopBreathing();
      drawRandomQuote();
      switchScreen('screen-score');
    }

    // 2. 노션 임베드 전용 링크 핸들러 (iframe 샌드박스 완벽 대응)
    const NOTION_URL = "https://www.notion.so/3b8ad9816a198011805ff67aa4e8857b";

    function openNotionLink(url) {
      try {
        // iframe 내부에서 팝업이 차단되지 않도록 top 수준 이동 또는 새 탭 열기
        window.open(url, '_blank', 'noopener,noreferrer');
      } catch (e) {
        window.location.href = url;
      }
    }

    function copyNotionLink(url) {
      if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(url).then(() => {
          alert("노션 링크가 복사되었습니다! 새 브라우저 창이나 노션 앱에 붙여넣어 주세요.");
        }).catch(() => fallbackCopy(url));
      } else {
        fallbackCopy(url);
      }
    }

    function fallbackCopy(text) {
      const input = document.createElement("input");
      input.value = text;
      document.body.appendChild(input);
      input.select();
      document.execCommand("copy");
      document.body.removeChild(input);
      alert("노션 링크가 복사되었습니다! 새 브라우저 창에 붙여넣어 주세요.");
    }

    // 3. 호흡하기 모듈
    let breatheInterval = null;
    let breatheCycle = 1;
    let isBreathing = false;

    function startBreathing() {
      switchScreen('screen-breathing');
      document.getElementById('breathe-prep-box').classList.remove('hidden');
      document.getElementById('breathe-active-box').classList.add('hidden');
      breatheCycle = 1;
    }

    function runBreatheCycle() {
      document.getElementById('breathe-prep-box').classList.add('hidden');
      document.getElementById('breathe-active-box').classList.remove('hidden');
      isBreathing = true;
      breatheCycle = 1;
      executeSingleCycle();
    }

    function executeSingleCycle() {
      if (!isBreathing) return;
      if (breatheCycle > 10) {
        stopBreathing();
        openScoreCheck();
        return;
      }

      document.getElementById('breathe-cycle-count').innerText = breatheCycle;
      const circle = document.getElementById('breathe-circle');
      const phaseText = document.getElementById('breathe-phase-text');
      const timerText = document.getElementById('breathe-timer');
      const guideText = document.getElementById('breathe-guide-comment');
      const imgInhale = document.getElementById('img-inhale');
      const imgExhale = document.getElementById('img-exhale');

      // 4초 들이쉬기
      imgInhale.style.opacity = '1';
      imgExhale.style.opacity = '0';
